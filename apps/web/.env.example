# Copy to .env.local for local Next.js dev:
#   cp .env.example .env.local
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Vercel production (astalakshimi-web.vercel.app):
# NEXT_PUBLIC_API_URL=http://43.204.228.63/api

# --- Media delivery (public S3 bucket / CloudFront) ---
# Leave CLOUDFRONT empty until the distribution is verified. getMediaUrl() then
# builds direct S3 URLs: https://<bucket>.s3.<region>.amazonaws.com/<key>
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_S3_MEDIA_BUCKET=ashtalakshmi-media
# Optional override, e.g. when fronting the bucket with a custom domain:
# NEXT_PUBLIC_S3_MEDIA_BASE_URL=https://ashtalakshmi-media.s3.ap-south-1.amazonaws.com
# Set once CloudFront is verified to switch every image to the CDN:
# NEXT_PUBLIC_CLOUDFRONT_URL=https://d111111abcdef8.cloudfront.net
