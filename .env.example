# ==============================================================================
# Astalakshimi Matrimony - Environment Configuration Template
# ==============================================================================
# Copy this file to .env at the root of the project:
# cp .env.example .env
# ==============================================================================

# --- Application Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL / Supabase / AWS RDS) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astalakshimi

# --- Authentication & Security ---
JWT_SECRET=astalakshimi-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
MOCK_OTP_ENABLED=true
DEFAULT_MOCK_OTP=123456

# --- AWS S3 Storage & Verification Vault ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_MEDIA_BUCKET=astalakshimi-media-dev
AWS_S3_VAULT_BUCKET=astalakshimi-vault-dev
CLOUDFRONT_URL=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
