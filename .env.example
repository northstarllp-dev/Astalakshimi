# ==============================================================================
# Astalakshimi - Environment Template
# ==============================================================================
# Copy to .env at repo root (used by apps/api + packages/database):
#   cp .env.example .env
#
# Copy web vars to apps/web/.env.local:
#   cp apps/web/.env.example apps/web/.env.local
# ==============================================================================

# --- Application Server (API) ---
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL / AWS RDS) ---
# Local dev: RDS must allow your public IP in its security group, or use local Postgres.
DATABASE_URL=postgresql://postgres:CHANGE_ME@your-db.region.rds.amazonaws.com:5432/ashtalakshmi?sslmode=require

# --- Authentication & Security ---
# JWT_SECRET must be a strong random value (32+ chars). Generate: openssl rand -hex 32
# The API refuses to start without a strong JWT_SECRET (any environment).
JWT_SECRET=change-me-64-random-hex-characters-minimum
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
OTP_TTL_SECONDS=300

# --- SMS Delivery (required — the only OTP path) ---
# OTP delivery fails closed: without a provider configured, the API refuses to start.
# Provider 1: apitxt (Unified OTP API - SMS, WhatsApp or Voice)
SMS_PROVIDER=apitxt
APITXT_AUTH_KEY=
APITXT_CHANNEL=sms
APITXT_TEMPLATE_ID=
APITXT_COUNTRY=91
# Provider 2: msg91
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=

# --- AWS S3 (required — live uploads only, no mock/demo storage) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_MEDIA_BUCKET=ashtalakshmi-media
AWS_S3_VAULT_BUCKET=ashtalakshmi-verification
CLOUDFRONT_URL=

# --- Frontend (Next.js) — also set in apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Razorpay (required for paid plans / extra contact unlock) ---
# Use Razorpay test keys locally (rzp_test_…). Leave both empty only if you will not exercise payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# EC2 production overrides (~/Astalakshimi/.env on the server)
# ==============================================================================
# NODE_ENV=production
# SMS_PROVIDER=apitxt (+ APITXT_AUTH_KEY) is required — the API refuses to start in production without it.
# JWT_SECRET must be a strong random value (32+ chars) or the API refuses to start.
# CORS_ORIGIN=http://localhost:3000,https://astalakshimi-web.vercel.app
#
# IMPORTANT: serve the API over HTTPS (e.g. behind Nginx/Caddy or a load balancer).
# The BFF proxies auth tokens over this URL — plain HTTP exposes them in transit.
#
# Vercel dashboard (apps/web project):
# NEXT_PUBLIC_API_URL=https://your-api-domain/api
