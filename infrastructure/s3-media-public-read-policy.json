{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadForMediaPrefixes",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::ashtalakshmi-media/profiles/*",
        "arn:aws:s3:::ashtalakshmi-media/horoscopes/*"
      ]
    }
  ]
}
